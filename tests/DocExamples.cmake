# Every ```xml block of a guide is a whole file the runtime must read: each one goes through the XML checker.
#   cmake -D DOC=<guide.md> -D CHECKER=<AnimationInjectorXmlCheck.exe> -D OUT=<folder> -D EXPECT=<count> -P DocExamples.cmake
file(READ "${DOC}" text)
string(REPLACE "\r\n" "\n" text "${text}")
get_filename_component(name "${DOC}" NAME_WE)
file(MAKE_DIRECTORY "${OUT}")
set(count 0)
while(TRUE)
    string(FIND "${text}" "```xml\n" open)
    if(open EQUAL -1)
        break()
    endif()
    math(EXPR begin "${open} + 7")
    string(SUBSTRING "${text}" ${begin} -1 text)
    string(FIND "${text}" "\n```" close)
    if(close EQUAL -1)
        message(FATAL_ERROR "${DOC}: an xml block is not closed")
    endif()
    string(SUBSTRING "${text}" 0 ${close} example)
    math(EXPR count "${count} + 1")
    set(file "${OUT}/${name}-${count}.xml")
    file(WRITE "${file}" "${example}\n")
    execute_process(COMMAND "${CHECKER}" "${file}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${DOC}: example ${count} is not read by the runtime:\n${output}")
    endif()
    string(SUBSTRING "${text}" ${close} -1 text)
endwhile()
# A guide that lost its examples (or a block marker typo) would otherwise pass with nothing checked.
if(NOT count EQUAL EXPECT)
    message(FATAL_ERROR "${DOC}: ${count} xml examples, expected ${EXPECT}")
endif()
message(STATUS "${DOC}: ${count} examples read")
