# tools/convert_v4.py on fixed inputs: a format 3 file becomes the expected bytes (every rule, CRLF and
# comments kept) and parses; a combo and a feature 0.12.238 removed are refused and left as they were.
# -D PYTHON=... CONVERTER=... CHECK=<AnimationInjectorXmlCheck> DATA=<tests/data/convert-v4> WORK=<dir>
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
configure_file("${DATA}/old.xml" "${WORK}/old.xml" COPYONLY)
configure_file("${DATA}/combo.xml" "${WORK}/combo.xml" COPYONLY)
configure_file("${DATA}/removed.xml" "${WORK}/removed.xml" COPYONLY)

execute_process(COMMAND "${PYTHON}" "${CONVERTER}" "${WORK}/old.xml" RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "converter failed (${rc}): ${out}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${WORK}/old.xml" "${DATA}/expected.xml" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "converted bytes differ from expected.xml")
endif()
execute_process(COMMAND "${CHECK}" "${WORK}/old.xml" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "converted file does not parse: ${out}${err}")
endif()

execute_process(COMMAND "${PYTHON}" "${CONVERTER}" "${WORK}/combo.xml" RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(rc EQUAL 0 OR NOT out MATCHES "SKIP.*combo")
    message(FATAL_ERROR "a combo was not refused: ${out}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${WORK}/combo.xml" "${DATA}/combo.xml" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "a refused file was changed")
endif()
execute_process(COMMAND "${PYTHON}" "${CONVERTER}" "${WORK}/removed.xml" RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(rc EQUAL 0 OR NOT out MATCHES "SKIP.*removed in 0\\.12\\.238 \\(Lock\\)")
    message(FATAL_ERROR "a removed feature was not refused: ${out}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${WORK}/removed.xml" "${DATA}/removed.xml" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "a refused file was changed")
endif()
message(STATUS "convert_v4: expected bytes, parses, combo and removed features refused untouched")
