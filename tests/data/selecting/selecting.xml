<?xml version="1.0" encoding="utf-8"?>
<!-- Starts that select (0.12.244): each card sends every route to an action. -->
<AnimationSet version="6" id="SelectingNoClip">
  <Inputs>
    <Input id="Use" key="G"/>
  </Inputs>
  <Start id="Pick" input="Use" block="SprintStop">
    <Check kind="global" plugin="Skyrim.esm" form="38" equals="1"/>
    <True to="A"/>
    <False to="B"/>
  </Start>
  <Action id="A" clip="Animations\Selecting\A.hkx"/>
  <Action id="B" clip="Animations\Selecting\B.hkx"/>
  <Start id="PairPick" to="PairA" event="Pick_Contact" target="combatTarget">
    <Check kind="global" plugin="Skyrim.esm" form="38" equals="1"/>
  </Start>
  <Pair id="PairA" clip="Animations\Selecting\PairA.hkx"/>
</AnimationSet>
