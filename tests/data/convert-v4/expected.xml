<?xml version="1.0" encoding="utf-8"?>
<!-- Every rule of tools/convert_v4.py once. A comment's markup is left alone:
     <Action id="Commented" clip="x.hkx"><Advanced graph="G"/></Action> gamepad="4096" -->
<AnimationSet version="4" id="ConvertV4">
  <Inputs>
    <Input id="Use" key="G" gamepad="A"/>
    <Input id="Alt" key="H" gamepad='RB'/>
    <Input id="Odd" key="J" gamepad="code:300"/>
    <Input id="Plain" key="K"/>
  </Inputs>
  <Action id="Plain" clip="Animations\Convert\Plain.hkx">
    <Start input="Use"/>
    <Require cooldown="0.2"/>
    <Advanced safety="0.7"/>
    <Exit blend="0.3"/>
  </Action>
  <Action id="Kept" clip="Animations\Convert\Kept.hkx">
    <Require air="allow" cooldown="0.2"/>
    <Advanced safety="2"/>
    <Cancel id="block" to="vanilla:Block"/>
    <Cancel to="vanilla:Jump"/>
    <Connect to="Plain" input="Alt"><Window from="0.4" until="end"/></Connect>
  </Action>
  <Action id="GraphOnly" clip="Animations\Convert\GraphOnly.hkx">
    <Cost stamina="25"/>
    <Advanced safety="0.7"/>
    <Require cooldown="0.5" stamina="25"/>
    <QTE id="Press" at="0.2" key="E" gamepad="B"/>
  </Action>
  <Action id="Tiny" clip="Animations\Convert\Tiny.hkx">
    <Require cooldown="0.2"/>
    <Advanced safety="0.7"/>
  </Action>
  <Pair id="Lift" clip="Animations\Convert\Lift.hkx">
    <Start input="Odd"/>
    <Require cooldown="1"/>
    <Carry bone="NPC R Hand [RHnd]" targetRoot="NPC Root [Root]" putdown="Down" input="Use" weapon="sheathe">
      <Hold blendOut="0.2"><Bone name="NPC R Clavicle [RClv]" weight="1"/></Hold>
    </Carry>
    <Target rig="chicken"/>
    <Advanced safety="30"/>
  </Pair>
  <Action id="Down" clip="Animations\Convert\Down.hkx">
    <Require cooldown="0.2"/>
    <Advanced safety="0.7"/>
    <CarryRelease at="0.8"/>
  </Action>
</AnimationSet>
