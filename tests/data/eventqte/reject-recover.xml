<?xml version="1.0" encoding="utf-8"?>
<!-- Starting while down (ragdoll="recover", 0.12.247) is gone: the Ragdoll Recovery plugin gets the player up. -->
<AnimationSet version="4" id="RecoverGone">
  <Action id="Up" clip="Animations\EventQte\Up.hkx">
    <Start event="Ragdoll" actor="player"/>
    <Require ragdoll="recover"/>
  </Action>
</AnimationSet>
