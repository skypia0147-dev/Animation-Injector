<?xml version="1.0" encoding="utf-8"?>
<AnimationSet version="6" id="DynamicDodgeShot">
  <Inputs>
    <Input id="a1_i1" key="Mouse2"/>
  </Inputs>
  <EventRegistry>
    <Event name="SoundPlay.WPNBowPullLPM"/>
    <Event name="SoundStop.WPNBowPullLPM"/>
    <Event name="SoundPlay.WPNBowFire"/>
    <Event name="DodgeShotFire">
      <Do op="fireArrow"/>
    </Event>
  </EventRegistry>
  <Start id="BowDodge" input="a1_i1" cooldown="0.2" block="blockStart,bashStart">
    <Check kind="weaponDrawn"/>
    <Check kind="equippedType" hand="left" type="bow"/>
    <Or><Check kind="attackState" state="bowAttached"/><Check kind="attackState" state="bowDrawn"/></Or>
    <True>
      <Check kind="sneaking"/>
      <True>
        <Row to="SneakBowDodge_B1"><Check kind="movementDirection" option="back"/></Row>
        <Row to="SneakBowDodge_L1"><Check kind="movementDirection" option="left"/></Row>
        <Row to="SneakBowDodge_R1"><Check kind="movementDirection" option="right"/></Row>
      </True>
      <False>
        <Row to="BowDodge_B1"><Check kind="movementDirection" option="back"/></Row>
        <Row to="BowDodge_L1"><Check kind="movementDirection" option="left"/></Row>
        <Row to="BowDodge_R1"><Check kind="movementDirection" option="right"/></Row>
      </False>
    </True>
  </Start>
  <Action id="BowDodge_B1" clip="Animations\DynamicDodgeShot\BowDodgeBack.hkx" safety="2.5">
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <MoveCancel at="1.647" blend="0.35"/>
    <FireArrow/>
  </Action>
  <Action id="BowDodge_L1" clip="Animations\DynamicDodgeShot\BowDodgeLeft.hkx" safety="2.5">
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <MoveCancel at="1.397" blend="0.35"/>
    <FireArrow/>
  </Action>
  <Action id="BowDodge_R1" clip="Animations\DynamicDodgeShot\BowDodgeRight.hkx" safety="2.5">
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <MoveCancel at="1.647" blend="0.35"/>
    <FireArrow/>
  </Action>
  <Action id="SneakBowDodge_B1" clip="Animations\DynamicDodgeShot\SneakBowDodgeBack.hkx" safety="2.5">
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <MoveCancel at="1.647" blend="0.35"/>
    <FireArrow/>
  </Action>
  <Action id="SneakBowDodge_L1" clip="Animations\DynamicDodgeShot\SneakBowDodgeLeft.hkx" safety="2.5">
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <MoveCancel at="1.397" blend="0.35"/>
    <FireArrow/>
  </Action>
  <Action id="SneakBowDodge_R1" clip="Animations\DynamicDodgeShot\SneakBowDodgeRight.hkx" safety="2.5">
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <MoveCancel at="1.647" blend="0.35"/>
    <FireArrow/>
  </Action>
</AnimationSet>
