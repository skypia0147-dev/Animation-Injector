  </Action>
  <Action id="SneakBowDodge_B1" clip="Animations\DynamicDodgeShot\SneakBowDodgeBack.hkx">
    <Require air="deny" cooldown="0.2"/>
    <Exit at="end-0.05" blend="0.3"/>
    <IFrame from="0" until="0.8"/>
    <Recovery at="1.647" blend="0.35"/>
    <FireArrow/>
    <Advanced safety="2.5"/>
  </Action>
  <Action id="SneakBowDodge_L1" clip="Animations\DynamicDodgeShot\SneakBowDodgeLeft.hkx">
