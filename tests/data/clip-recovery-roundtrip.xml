<?xml version="1.0" encoding="utf-8"?>
<!-- Movement-key cancel (Recovery) as format 4 writes it: one per action (a combo's per-Step rule went with combos). -->
<AnimationSet version="6" id="ClipRecovery">
  <Start id="BowDodgeBack_Start" to="BowDodgeBack" key="Mouse2" cooldown="0.2">
    <Check kind="weaponDrawn"/>
  </Start>
  <Action id="BowDodgeBack" clip="Animations\DynamicDodgeShot\BowDodgeBack.hkx" safety="2.5">
    <MoveCancel at="0.3" blend="0.1"/>
    <Exit blend="0.3"/>
    <Transition to="BowDodgeLeft" key="Mouse2" from="0.2"/>
  </Action>
  <Action id="BowDodgeLeft" clip="Animations\DynamicDodgeShot\BowDodgeLeft.hkx" safety="2.5">
    <MoveCancel at="event:MoveReady" blend="0.25"/>
    <Exit blend="0.3"/>
    <Transition to="BowDodgeRight" key="Mouse2"/>
  </Action>
  <Action id="BowDodgeRight" clip="Animations\DynamicDodgeShot\BowDodgeRight.hkx" safety="2.5">
    <MoveCancel at="1.1" blend="0.4"/>
    <Exit blend="0.3"/>
  </Action>
</AnimationSet>
